# Copy this file to .env and fill in your credentials.
# .env is gitignored.

# OpenSky Network credentials.
# Sign up at https://opensky-network.org/ to get free authenticated access.
# Required by src/fleet_tracker/collectors/opensky.py.
#
# Two auth styles are supported. Prefer OAuth client credentials if your
# OpenSky account has them; fall back to basic auth otherwise.

# OAuth client credentials (preferred):
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Legacy HTTP Basic (fallback):
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
